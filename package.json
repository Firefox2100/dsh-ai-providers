{
  "name": "dsh-ai-providers-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "release:build": "pnpm --filter './packages/**' run build",
    "watch": "pnpm -r --parallel run watch",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test --coverage --coverage.reporter=text --coverage.reporter=lcov && node scripts/merge-coverage.mjs",
    "release:check": "node scripts/check-release.mjs",
    "check:dsh": "node scripts/check-dsh-compat.mjs",
    "sync:dsh": "node scripts/sync-dsh-ranges.mjs",
    "release:publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11"
  }
}
