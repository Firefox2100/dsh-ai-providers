{
  "name": "@dsh-ai-providers/localai",
  "version": "0.1.1",
  "description": "First-class LocalAI provider for DSH language, embedding, reranking, speech, and image services.",
  "author": {"name": "Firefox2100", "url": "https://github.com/Firefox2100"},
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "engines": {"node": ">=22"},
  "repository": {"type": "git", "url": "git+https://github.com/Firefox2100/dsh-ai-providers.git", "directory": "packages/dsh-ai-localai"},
  "homepage": "https://firefox2100.github.io/dsh-ai-providers/docs/official-providers/localai",
  "bugs": {"url": "https://github.com/Firefox2100/dsh-ai-providers/issues"},
  "keywords": ["deepseek-harness", "dsh", "localai", "ai-provider"],
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
