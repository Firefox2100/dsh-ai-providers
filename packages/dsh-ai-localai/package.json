  "dependencies": { "@deepseek-ai/schemastery": "^3.18.4", "@dsh-ai-providers/openai-compatible": "workspace:0.1.1" },
  "devDependencies": { "@deepseek-ai/cordis": "^4.0.4", "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2", "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2", "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2", "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2", "@deepseek-ai/dsh-credentials": "0.2.0-rc.2", "@types/node": "^22.20.0", "@types/react": "~18.3.31", "@dsh-ai-providers/core": "workspace:0.1.1", "@dsh-ai-providers/openai-compatible": "workspace:0.1.1", "react": "^18.3.1", "tsdown": "^0.22.2", "typescript": "^6.0.3", "vitest": "^4.1.8" }
