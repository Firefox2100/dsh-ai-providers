{
  "name": "@dsh-ai-providers/all",
  "version": "0.7.3",
  "description": "Complete Firefox2100-maintained AI provider bundle for DeepSeek Harness.",
  "author": {"name": "Firefox2100", "url": "https://github.com/Firefox2100"},
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
