    "@dsh-ai-providers/jina": "workspace:0.7.3",
    "@dsh-ai-providers/localai": "workspace:0.7.3",
    "@dsh-ai-providers/ollama": "workspace:0.7.3",
    "@dsh-ai-providers/cohere": "workspace:0.7.3",
    "@dsh-ai-providers/dashscope": "workspace:0.7.3",
    "@dsh-ai-providers/typesafe": "workspace:0.7.3"
